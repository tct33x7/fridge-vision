# 香橙派配置
SMART_FRIDGE_MAX_UPLOAD_MB=15

# USB 摄像头（仅使用 USB 摄像头，不提供设备选择）
SMART_FRIDGE_CAMERA_DEVICE=/dev/v4l/by-id/usb-UGREEN_Camera_UGREEN_Camera_SN0001-video-index0
SMART_FRIDGE_CAMERA_WIDTH=640
SMART_FRIDGE_CAMERA_HEIGHT=480
SMART_FRIDGE_CAMERA_FPS=15
SMART_FRIDGE_CAMERA_JPEG_QUALITY=82
SMART_FRIDGE_CAMERA_MODE=auto

# Orange Pi 4 Pro：物理 7 号脚 = PL4 = wiringOP 编号 2
SMART_FRIDGE_GPIO_BUTTON_ENABLED=true
SMART_FRIDGE_GPIO_BUTTON_WPI_PIN=2
SMART_FRIDGE_GPIO_BUTTON_ACTIVE_LOW=false
SMART_FRIDGE_GPIO_BUTTON_DEBOUNCE_MS=500

# YOLO 食物检测模型路径
SMART_FRIDGE_YOLO_MODEL=yolo/food_best.onnx
SMART_FRIDGE_YOLO_CLASSES=yolo/classes.txt
SMART_FRIDGE_YOLO_CONFIDENCE=0.25
SMART_FRIDGE_YOLO_IOU=0.45

# DeepSeek AI（可选，留空则使用本地规则推荐）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=25

# 物品进出自动计数（yolo_web_counter 集成，默认占用 UGREEN 摄像头）
SMART_FRIDGE_COUNTER_ENABLED=true
SMART_FRIDGE_COUNTER_MODEL=models/yolo11s.pt
SMART_FRIDGE_COUNTER_IMGSZ=320
SMART_FRIDGE_COUNTER_CONFIDENCE=0.35
# 摄像头占用模式默认值：counter=自动计数，manual=手动拍照
SMART_FRIDGE_DEFAULT_CAMERA_MODE=counter
