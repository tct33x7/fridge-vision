[Unit]
Description=Smart Fridge · 食光冰箱
After=network-online.target lightdm.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/orangepi/smart_fridge_demo
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/orangepi/.Xauthority
EnvironmentFile=-/home/orangepi/smart_fridge_demo/.env
ExecStart=/home/orangepi/smart_fridge_demo/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8080
ExecStartPost=/bin/bash /home/orangepi/smart_fridge_demo/open_browser.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
