# 本地存储位置（默认使用项目内 storage/）
# SMART_FRIDGE_STORAGE_DIR=/home/orangepi/smart_fridge_demo/storage
# SMART_FRIDGE_DB_PATH=/home/orangepi/smart_fridge_demo/storage/database/smart_fridge.db
SMART_FRIDGE_MAX_UPLOAD_MB=15

# USB 摄像头（Orange Pi 默认设备）
SMART_FRIDGE_CAMERA_DEVICE=/dev/video0
SMART_FRIDGE_CAMERA_WIDTH=1280
SMART_FRIDGE_CAMERA_HEIGHT=720
SMART_FRIDGE_CAMERA_FPS=15
SMART_FRIDGE_CAMERA_JPEG_QUALITY=82

# Orange Pi 4 Pro：物理 7 号脚 = PL4 = wiringOP 编号 2
SMART_FRIDGE_GPIO_BUTTON_ENABLED=true
SMART_FRIDGE_GPIO_BUTTON_WPI_PIN=2
SMART_FRIDGE_GPIO_BUTTON_ACTIVE_LOW=true
SMART_FRIDGE_GPIO_BUTTON_DEBOUNCE_MS=500

# YOLO 食物检测（均有默认值；仅在移动模型或调参时取消注释）
# SMART_FRIDGE_YOLO_MODEL=/home/orangepi/smart_fridge_demo/yolo/food_best.onnx
# SMART_FRIDGE_YOLO_CLASSES=/home/orangepi/smart_fridge_demo/yolo/classes.txt
# SMART_FRIDGE_YOLO_CONFIDENCE=0.25
# SMART_FRIDGE_YOLO_IOU=0.45

# 可选的部署环境覆盖；桌面用户优先编辑 config/api_settings.json。
# 环境变量优先级高于 JSON 配置。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=25
