# macOS / 编辑器
.DS_Store
.idea/
.vscode/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 本地密钥与环境（绝不提交）
.env
archive/smart_fridge_demo/config/api_settings.json

# 运行数据（数据库、上传图片、备份）
archive/smart_fridge_demo/storage/*/*
!archive/smart_fridge_demo/storage/*/.gitkeep
smart_fridge_app/runtime/
smart_fridge_app/backups/
archive/camera_system/captures/
archive/camera_system/data/

# 模型权重：正本只有 fridge_vision/models/food_best.onnx（10.7 MB），其余 .onnx 不入库（archive 里是指向它的符号链接）
*.onnx
!fridge_vision/models/food_best.onnx
*.pt

# 压缩包与运行期上传
*.zip

# fridge_vision 运行输出与自动下载的权重
fridge_vision/runs/
fridge_vision/*.pt

# demo 自带的通用预训练权重（19MB，COCO，非自训）需要提交
!demos/yolo_web_counter/models/yolo11s.pt

# 个人资料（只在本机，永不进 git）
private/
