# Main application: the only service exposed to the LAN.
SMART_FRIDGE_HOST=0.0.0.0
SMART_FRIDGE_PORT=8000

# Camera daemon: keep this on localhost and let the main app proxy it.
SMART_FRIDGE_CAMERA_URL=http://127.0.0.1:8001
SMART_FRIDGE_CAMERA_TIMEOUT_SECONDS=3

# Runtime data is never bundled with source releases.
SMART_FRIDGE_DATA_DIR=runtime

